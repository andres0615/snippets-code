{
	"Laravel Model": {
		"scope": "php",
		"prefix": "l-model",
		"description": "Esquema básico de un modelo Eloquent para Laravel",
		"body": [
			"",
			"",
			"namespace ${1:App\\\\Models};",
			"",
			"use Illuminate\\\\Database\\\\Eloquent\\\\Model;",
			"use Illuminate\\\\Database\\\\Eloquent\\\\Factories\\\\HasFactory;",
			"",
			"class ${2:NombreModelo} extends Model",
			"{",
			"    use HasFactory;",
			"",
			"    protected \\$table = '${3:nombre_tabla}';",
			"",
			"    protected \\$fillable = [",
			"        '${4:campo1}',",
			"        '${5:campo2}',",
			"    ];",
			"",
			"    protected \\$hidden = [",
			"        '${6:password}',",
			"    ];",
			"",
			"    protected function casts(): array",
			"    {",
			"        return [",
			"            '${7:campo}' => '${8:datetime}',",
			"        ];",
			"    }",
			"    $0",
			"}"
		]
	},
	"PHP Try-Catch JSON Response": {
		"scope": "php",
		"prefix": "l-try",
		"description": "Try-catch con respuesta JSON de error 500",
		"body": [
			"try {",
			"\t$0",
			"} catch (\\\\Exception \\$e) {",
			"\t// Si hay errores generales",
			"\t\\$errorMessage = '${1:Error al crear el producto}: ' . \\$e->getMessage();",
			"\t",
			"\treturn response()->json([",
			"\t\t'success' => false,",
			"\t\t'message' => \\$errorMessage,",
			"\t], 500);",
			"}"
		]
	},
	"Laravel success response": {
		"scope": "php",
		"prefix": "l-res-success",
		"description": "Laravel success response",
		"body": [
			"\\$responseData = [",
			"    'success' => true,",
			"    'data' => [",
			"        $0",
			"    ],",
			"];"
		]
	},
	"Laravel Controller": {
		"scope": "php",
		"prefix": "l-controller",
		"description": "Esquema básico de un Controlador para Laravel",
		"body": [
			"<?php",
			"",
			"namespace App\\Http\\Controllers;",
			"",
			"use App\\Models\\ProductStatus;",
			"use Illuminate\\Http\\Request;",
			"",
			"class ProductStatusController extends Controller",
			"{",
			"    public function index()",
			"    {",
			"        try {",
			"            \\$statuses = ProductStatus::all();",
			"",
			"            \\$responseData = [",
			"                'success' => true,",
			"                'data' => [",
			"                   'statuses' => \\$statuses,",
			"                ],",
			"            ];",
			"",
			"            return response()->json(\\$responseData);",
			"        } catch (\\Exception \\$e) {",
			"            return response()->json([",
			"                'success' => false,",
			"                'message' => 'Error al consultar los estados de producto: ' . \\$e->getMessage(),",
			"            ], 500);",
			"        }",
			"    }",
			"}"
		]
	},
}