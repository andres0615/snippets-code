{
	// Place your snippets for typescriptreact here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Console log": {
		"prefix": "clog",
		"body": [
			"console.log('$1');",
			"$0"
		],
		"description": "Inserta un console.log rápido"
	},
	"Export Default Function Component": {
		"prefix": "r-component",
		"body": [
			"export default function ${1:ComponentName}() {",
			"  return (",
			"    <>",
			"      $0",
			"    </>",
			"  );",
			"}"
		],
		"description": "Crea un componente funcional con export default y fragment"
	},
	"useState con valor inicial": {
		"prefix": "r-state-variable",
		"body": [
			"const [${1:maxWidth}, ${2:setMaxWidth}] = useState('${3:max-w-4xl}')"
		],
		"description": "Declara un estado con useState y un valor inicial"
	},
	"Imports": {
		"prefix": "r-import",
		"body": [
			"import { ${0:ProductStatus} } from '@/types/product-status';"
		],
		"description": "Hacer imports"
	},
	"Event Handler": {
		"prefix": "r-event-handler",
		"body": [
			"// Cambiar de página en la paginación",
			"const handlePageChange = (page: number): void => {",
			"\tsetCurrentPage(page);",
			"}"
		],
		"description": "Crea un handler para eventos"
	},
	"Use Effect": {
		"prefix": "r-use-effect",
		"body": [
			"useEffect(() => {",
			"\tsetMaxWidth('max-w-[61rem]');",
			"\treturn () => setMaxWidth('max-w-4xl');",
			"}, [setMaxWidth]);"
		],
		"description": "Esquema de useEffect"
	},
	"JSX Map": {
		"prefix": "r-map-jsx",
		"body": [
			"{productStatuses.map((status) => (",
			"\t<option key={status.id} value={status.id}>",
			"\t\t{status.name}",
			"\t</option>",
			"))}"
		],
		"description": "Esquema para map en JSX"
	},
	"Fetch from service": {
		"prefix": "r-fetch",
		"body": [
			"fetchProductStatus()",
			"\t.then((result) => {",
			"\t\tsetProductStatuses(result);",
			"\t})",
			"\t.catch((err) => console.error(err))",
			"\t.finally(() => { });"
		],
		"description": "Esquema para fetch en tsx"
	},
	"Link to create": {
		"prefix": "r-link",
		"body": [
			"<Link to=\"/products/create\" className=\"btn btn-primary\">",
			"  Añadir Producto",
			"</Link>"
		],
		"description": "Esquema de Link en tsx"
	}
}